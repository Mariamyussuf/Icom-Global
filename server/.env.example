# Server Environment Variables
# Copy this file to .env and fill in your values

# Server
NODE_ENV=production
PORT=5000

# Email Configuration (SMTP)
# Use App Passwords for Gmail, or a transactional service (Brevo, Postmark, Mailgun)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Contact form recipient
CONTACT_RECEIVER_EMAIL=icomtssl@gmail.com

# Frontend URL (for CORS)
ALLOWED_ORIGIN=https://icomtsl.com
